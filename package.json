    "helmet": "^7.1.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.22.4",
    "sequelize": "^3.30.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}
