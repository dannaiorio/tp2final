{
  "name": "trabajo-practico-final-tp2",
  "version": "1.0.0",
  "description": "Proyecto de Node.js con Express, Sequelize y arquitectura MVC",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:migrate": "npx sequelize-cli db:migrate",
